# One-laptop rehearsal cluster: same keys as cluster.env, everything on localhost.
# Select it with FOODPIPE_ENV=cluster.local. Ports differ from cluster.env so it can run next to a real broker.
# Plain KEY=value lines only: no spaces around "=", no quotes, no variable expansion.

# Every role on this machine
VM1_IP=127.0.0.1
VM2_IP=127.0.0.1
VM3_IP=127.0.0.1
VM4_IP=127.0.0.1
STANDBY_IP=127.0.0.1

# Kafka listeners
VM2_KAFKA_PORT=19092
VM3_KAFKA_PORT=19094
CONTROLLER_PORT=19093

# Separate cluster id for the rehearsal cluster
CLUSTER_ID=lqQV33ViQ2mcdNakqwyhig

# Broker data lives inside the repo (git-ignored)
KAFKA_DATA_ROOT=.kafka-local

# Course-pinned Kafka build
KAFKA_VERSION=3.9.2
SCALA_VERSION=2.12

# Topics
TOPIC_ORDERS=orders
TOPIC_METRICS=order_metrics
TOPIC_PARTITIONS=2
TOPIC_RF=2
