# Shared cluster settings for all machines (sourced by kafka/ and scripts/, read by foodpipe/config.py).
# Plain KEY=value lines only: no spaces around "=", no quotes, no variable expansion.

# ZeroTier IPs per role (network food-ordering, 192.168.193.0/24)
VM1_IP=CHANGE_ME
VM2_IP=192.168.193.217
VM3_IP=192.168.193.247
VM4_IP=192.168.193.80
STANDBY_IP=192.168.193.214

# Kafka listeners
VM2_KAFKA_PORT=9092
VM3_KAFKA_PORT=9092
CONTROLLER_PORT=9093

# KRaft cluster id: VM2 is already formatted with it, never regenerate
CLUSTER_ID=jbLv2nD5Tf6eYZrYdejohg

# Course-pinned Kafka build
KAFKA_VERSION=3.9.2
SCALA_VERSION=2.12

# Topics
TOPIC_ORDERS=orders
TOPIC_METRICS=order_metrics
TOPIC_PARTITIONS=2
TOPIC_RF=2
